# Discord Bot Configuration
# Copy this file to .env and fill in your actual values

# Your Discord Bot Token (from https://discord.com/developers/applications)
TOKEN=your_bot_token_here

# Your Discord Application ID (from https://discord.com/developers/applications)
APP_ID=your_application_id_here

# Port for health check server (default: 3000)
# Render.com will automatically set this
PORT=3000

# MongoDB Connection URI (from MongoDB Atlas)
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# REQUIRED for persistent data storage (birthdays will be lost on restart without this)
MONGODB_URI=your_mongodb_connection_string_here
